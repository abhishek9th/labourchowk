# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Only the PUBLIC anon key goes here. NEVER put the service_role key in a VITE_ variable
# (everything prefixed VITE_ is shipped to the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: shown on the Contact section of the footer / legal pages
VITE_CONTACT_EMAIL=support@example.com

# The public address used inside QR codes, printed visiting cards and shared profile links:
#   https://YOUR_PRODUCTION_DOMAIN/p/PUBLIC_ID
# REQUIRED in production builds. If unset, the app falls back to the page's own origin and the
# worker's "Skill Passport" page shows a warning (never print cards from a localhost/preview URL).
VITE_PUBLIC_BASE_URL=https://your-production-domain.example
